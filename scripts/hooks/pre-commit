#!/usr/bin/env bash
# Fast checks before each commit, scoped to what is staged: lint the staged files and
# run the backend unit tests related to them. The full gate runs before push.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git -C "$root" diff --cached --name-only --diff-filter=ACMR)
((${#staged[@]})) || exit 0

backend=() shell=0 dart=0 e2e=0
for file in "${staged[@]}"; do
  case "$file" in
    backend/*.ts | backend/*.js | backend/*.cjs | backend/*.mjs | backend/*.json) backend+=("${file#backend/}") ;;
    test/e2e/api/*) e2e=1 ;;
    pao | scripts/* | test/cli/* | test/e2e/*.sh | backend/scripts/*) shell=1 ;;
    frontend/*) dart=1 ;;
  esac
done

"$root/pao" lint sizes
"$root/pao" lint shell
if ((shell)); then bats "$root/test/cli" >/dev/null; fi
if ((${#backend[@]})); then
  (
    cd "$root/backend"
    mapfile -t sources < <(printf '%s\n' "${backend[@]}" | grep -E '\.(ts|js|cjs|mjs)$' || true)
    npx prettier --check "${backend[@]}" >/dev/null
    if ((${#sources[@]})); then
      # Generated sqlc files are eslint-ignored; without the flag their warning fails.
      npx eslint --max-warnings 0 --no-warn-ignored "${sources[@]}"
      npm run -s typecheck
      npx jest --selectProjects unit --silent --passWithNoTests --findRelatedTests "${sources[@]}"
    fi
  )
fi
if ((e2e)); then (cd "$root/test/e2e/api" && npm run -s lint); fi
if ((dart)); then
  # Flutter reads its own version with git; the commit's GIT_* variables would point
  # it at this repository instead and break version solving.
  (
    unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
    "$root/pao" lint dart
    "$root/pao" test dart
  )
fi
