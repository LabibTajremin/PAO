# PAO configuration. Every variable is read by backend/internal/platform/config.
# Copy to .env for local development (./pao setup does this). Never commit .env.
# Values below are local-development placeholders, not secrets.

# Runtime environment: dev | test | staging | prod. "test" enables the test-only
# message capture endpoint used by the e2e suite.
APP_ENV=dev
# Log level: debug | info | warn | error.
LOG_LEVEL=info
# Public API listen address.
HTTP_ADDR=:8080
# Internal listen address for /metrics (never exposed publicly).
METRICS_ADDR=:9090

# PostgreSQL 16 + PostGIS 3 connection string.
DATABASE_URL=postgres://pao:pao@localhost:5432/pao?sslmode=disable
# Redis 7 connection URL.
REDIS_URL=redis://localhost:6379/0

# S3-compatible storage (MinIO locally).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pao-local
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_PRIVATE=pao-private
S3_BUCKET_PUBLIC=pao-public

# Ed25519 private key seed (32 bytes, base64) used to sign access tokens, and its key ID.
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=
JWT_KEY_ID=k1
# Previous public keys still accepted during rotation: "kid:base64pub,kid2:base64pub".
JWT_PREVIOUS_PUBLIC_KEYS=
# AES-256-GCM key (32 bytes, base64) for encrypted fields (NID numbers, TOTP secrets). Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Origin allowed by CORS for the admin web app.
ADMIN_CORS_ORIGIN=http://localhost:5000

# SMS adapter: console (logs codes) | sslwireless.
SMS_ADAPTER=console
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
# Push adapter: log | fcm.
PUSH_ADAPTER=log
# Path to the FCM service-account JSON file (only when PUSH_ADAPTER=fcm).
FCM_CREDENTIALS_FILE=

# Password for the demo admin users created by ./pao seed (dev/staging only).
SEED_ADMIN_PASSWORD=
