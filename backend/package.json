{
  "name": "pao-backend",
  "version": "0.0.0",
  "private": true,
  "description": "PAO backend: NestJS modular monolith serving api/openapi.yaml (ADR-0032).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check . && depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "gen": "bash scripts/gen.sh",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:cover": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cookie-parser": "1.4.7",
    "google-auth-library": "11.2.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.7",
    "@redocly/openapi-core": "1.34.20",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.0",
    "jest": "30.5.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
