# Environment and secrets
.env
*.pem
*.key

# Generated output: coverage, the perf fixture, the e2e stack's state
/out/

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
build/
**/coverage/
*.iml
.idea/
pubspec_overrides.yaml

# OS / editors
.DS_Store
# The shared editor set-up is committed; personal settings are not.
.vscode/settings.local.json
*.swp
# An empty CA bundle the compose build uses when PAO_EXTRA_CA_FILE is unset.
!infra/no-extra-ca.pem

# Developer settings copied from Backend/appsettings.Local.example.json.
Backend/appsettings.Local.json

# Local state of tools/autopilot.sh
.autopilot/

# Backend logs are written at run time, never committed.
Backend/Logs/
