{
  "uid": "pao-worker",
  "title": "PAO worker: jobs and outbox",
  "description": "Scheduled job runs and outbox delivery lag from pao_job_* and pao_outbox_*.",
  "tags": [
    "pao",
    "worker"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "Asia/Dhaka",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Job failures (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(pao_job_runs_total{outcome=\"failed\"}[1h]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest pending event",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(pao_outbox_oldest_pending_seconds)",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pending events",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(pao_outbox_pending_events)",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dead-lettered events",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(pao_outbox_dead_events)",
          "legendFormat": "dead"
        }
      ],
      "description": "Kept for inspection; see docs/runbooks/incident-checklist.md for replaying them."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job runs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name, outcome) (increase(pao_job_runs_total[$__rate_interval]))",
          "legendFormat": "{{name}} {{outcome}}"
        }
      ],
      "description": "skipped means another worker held the job's lock, which is normal with several workers."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(pao_job_duration_seconds_bucket[1h])))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbox lag by module",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (module) (pao_outbox_oldest_pending_seconds)",
          "legendFormat": "{{module}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pending events by module",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (module) (pao_outbox_pending_events)",
          "legendFormat": "{{module}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Events delivered per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (module) (rate(pao_outbox_events_delivered_total[5m]))",
          "legendFormat": "{{module}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Delivery failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (event, dead) (rate(pao_outbox_delivery_failures_total[5m]))",
          "legendFormat": "{{event}} dead={{dead}}"
        }
      ]
    }
  ]
}
