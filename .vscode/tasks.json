{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build backend",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/PAO.sln", "-nologo", "-v", "quiet"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pao up (Docker stack)",
      "type": "shell",
      "command": "./pao up",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "pao down",
      "type": "shell",
      "command": "./pao down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "pao ci (every gate)",
      "type": "shell",
      "command": "./pao ci",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "pao test unit",
      "type": "shell",
      "command": "./pao test unit",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
