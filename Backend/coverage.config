<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage scope: hand-written code of the backend. The only exclusions (ADR-0034,
     03-testing.md §2): generated code and the three Program.cs composition roots, which
     the start-up smoke tests run. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[/\\]PAO\.(EF|Lib|Infrastructure|BackgroundJobs|Core|Worker|Migrator|Gates)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[/\\]PAO\.(Core|Worker|Migrator)[/\\]Program\.cs$</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <IncludeTestAssembly>false</IncludeTestAssembly>
  </CodeCoverage>
</Configuration>
